{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spfx-kit.dev/schemas/ui-profile-v1.json",
  "title": "SPFx Kit offline UI source profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatorVersion",
    "profileId",
    "provenanceSha256",
    "normalizationImplementationSha256",
    "compilerInputs",
    "css",
    "dependencyClosure",
    "baseUiDeclarationTransform",
    "baseUiPopupLifecycleTransform",
    "baseUiIdOwnershipTransform",
    "ownedSources",
    "items"
  ],
  "properties": {
    "$schema": { "const": "./profile.schema.json" },
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profileId": { "const": "spfx-react17-base-nova-v1" },
    "provenanceSha256": { "$ref": "#/$defs/sha256" },
    "normalizationImplementationSha256": { "$ref": "#/$defs/sha256" },
    "compilerInputs": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "prefixItems": [
        { "$ref": "#/$defs/compilerBridge" },
        { "$ref": "#/$defs/selectValueCompatibilityProbe" },
        { "$ref": "#/$defs/idOwnershipContractSchema" },
        { "$ref": "#/$defs/tailwindCssEntry" },
        { "$ref": "#/$defs/tailwindCssBuildImplementation" },
        { "$ref": "#/$defs/tailwindCssVerificationImplementation" },
        { "$ref": "#/$defs/tailwindCssCompilerImplementation" },
        { "$ref": "#/$defs/tailwindCssScoperImplementation" },
        { "$ref": "#/$defs/tailwindCssNetworkBlockerImplementation" },
        { "$ref": "#/$defs/typecheckImplementation" },
        { "$ref": "#/$defs/profileGenerationImplementation" },
        { "$ref": "#/$defs/profileUpdateIntakeImplementation" },
        { "$ref": "#/$defs/shadcnRegistryWorkerImplementation" },
        { "$ref": "#/$defs/generatedProfileTypecheckImplementation" },
        { "$ref": "#/$defs/validatedProfileGenerationImplementation" },
        { "$ref": "#/$defs/generationTransactionImplementation" },
        { "$ref": "#/$defs/generatedReplacementImplementation" },
        { "$ref": "#/$defs/generatedTreeClosureImplementation" },
        { "$ref": "#/$defs/dependencyClosureVerificationImplementation" },
        { "$ref": "#/$defs/baseUiPreparationImplementation" },
        { "$ref": "#/$defs/selectValueTransformImplementation" },
        { "$ref": "#/$defs/popupLifecycleTransformImplementation" },
        { "$ref": "#/$defs/idOwnershipTransformImplementation" },
        { "$ref": "#/$defs/preparationLockImplementation" },
        { "$ref": "#/$defs/tsconfigBase" },
        { "$ref": "#/$defs/tsconfigTs53" },
        { "$ref": "#/$defs/tsconfigTs58" }
      ],
      "items": false
    },
    "css": { "$ref": "#/$defs/cssContract" },
    "dependencyClosure": { "$ref": "#/$defs/snapshot" },
    "baseUiDeclarationTransform": { "$ref": "#/$defs/snapshot" },
    "baseUiPopupLifecycleTransform": { "$ref": "#/$defs/snapshot" },
    "baseUiIdOwnershipTransform": { "$ref": "#/$defs/snapshot" },
    "ownedSources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{ "$ref": "#/$defs/ownedThemeSource" }, { "$ref": "#/$defs/ownedRootSource" }],
      "items": false
    },
    "items": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/].*" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ownedThemeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "output", "transformations"],
      "properties": {
        "source": {
          "allOf": [
            { "$ref": "#/$defs/snapshot" },
            { "type": "object", "properties": { "path": { "const": "owned/src/lib/spfx-theme.ts" } } }
          ]
        },
        "output": {
          "allOf": [
            { "$ref": "#/$defs/snapshot" },
            { "type": "object", "properties": { "path": { "const": "normalized/src/lib/spfx-theme.ts" } } }
          ]
        },
        "transformations": { "const": ["copy-owned-host-contract"] }
      }
    },
    "ownedRootSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "output", "transformations"],
      "properties": {
        "source": {
          "allOf": [
            { "$ref": "#/$defs/snapshot" },
            { "type": "object", "properties": { "path": { "const": "owned/src/lib/ui-root.tsx" } } }
          ]
        },
        "output": {
          "allOf": [
            { "$ref": "#/$defs/snapshot" },
            { "type": "object", "properties": { "path": { "const": "normalized/src/lib/ui-root.tsx" } } }
          ]
        },
        "transformations": { "const": ["copy-owned-host-contract"] }
      }
    },
    "compilerBridge": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "compat-consumers/react17-base-ui-jsx.d.ts" } } }
      ]
    },
    "selectValueCompatibilityProbe": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "compat-consumers/select-value.tsx" } } }
      ]
    },
    "idOwnershipContractSchema": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "compat/base-ui-1.6.0/id-ownership/contract.schema.json" } } }
      ]
    },
    "tailwindCssEntry": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "tailwind-profile.css" } } }
      ]
    },
    "tailwindCssBuildImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/build-tailwind-css.mjs" } } }
      ]
    },
    "tailwindCssVerificationImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/verify-tailwind-css.mjs" } } }
      ]
    },
    "tailwindCssCompilerImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "type": "object",
          "properties": { "path": { "const": "scripts/lib/compile-tailwind-css.mjs" } }
        }
      ]
    },
    "tailwindCssScoperImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/lib/scope-tailwind-css.mjs" } } }
      ]
    },
    "tailwindCssNetworkBlockerImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/lib/block-network.mjs" } } }
      ]
    },
    "typecheckImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/typecheck.mjs" } } }
      ]
    },
    "profileGenerationImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/lib/generate-profile.mjs" } } }
      ]
    },
    "profileUpdateIntakeImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "type": "object",
          "properties": { "path": { "const": "scripts/lib/profile-update-intake.mjs" } }
        }
      ]
    },
    "shadcnRegistryWorkerImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "type": "object",
          "properties": { "path": { "const": "scripts/lib/shadcn-registry-worker.mjs" } }
        }
      ]
    },
    "generatedProfileTypecheckImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "type": "object",
          "properties": { "path": { "const": "scripts/lib/typecheck-generated-profile.mjs" } }
        }
      ]
    },
    "validatedProfileGenerationImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "type": "object",
          "properties": { "path": { "const": "scripts/lib/generate-validated-profile.mjs" } }
        }
      ]
    },
    "generationTransactionImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/lib/generation-transaction.mjs" } } }
      ]
    },
    "generatedReplacementImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/lib/replace-generated.mjs" } } }
      ]
    },
    "generatedTreeClosureImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/lib/generated-tree-closure.mjs" } } }
      ]
    },
    "dependencyClosureVerificationImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "type": "object",
          "properties": { "path": { "const": "scripts/verify-dependency-closure.mjs" } }
        }
      ]
    },
    "baseUiPreparationImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/prepare-base-ui.mjs" } } }
      ]
    },
    "selectValueTransformImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "type": "object",
          "properties": { "path": { "const": "scripts/transform-base-ui-select-value.mjs" } }
        }
      ]
    },
    "popupLifecycleTransformImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "type": "object",
          "properties": { "path": { "const": "scripts/transform-base-ui-popup-lifecycle.mjs" } }
        }
      ]
    },
    "idOwnershipTransformImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "type": "object",
          "properties": { "path": { "const": "scripts/transform-base-ui-id-ownership.mjs" } }
        }
      ]
    },
    "preparationLockImplementation": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        { "type": "object", "properties": { "path": { "const": "scripts/lib/preparation-lock.mjs" } } }
      ]
    },
    "tsconfigBase": {
      "allOf": [{ "$ref": "#/$defs/snapshot" }, { "type": "object", "properties": { "path": { "const": "tsconfig.base.json" } } }]
    },
    "tsconfigTs53": {
      "allOf": [{ "$ref": "#/$defs/snapshot" }, { "type": "object", "properties": { "path": { "const": "tsconfig.ts53.json" } } }]
    },
    "tsconfigTs58": {
      "allOf": [{ "$ref": "#/$defs/snapshot" }, { "type": "object", "properties": { "path": { "const": "tsconfig.ts58.json" } } }]
    },
    "cssContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "animationSource",
        "compiler",
        "scoper",
        "networkBlocker",
        "toolchainSha256",
        "scopeSeedSha256",
        "scopeValue",
        "scopeSelector",
        "artifact",
        "candidateCount",
        "structuralMarkers",
        "conditionalClasses",
        "keyframeCount",
        "containerCount",
        "fallbackPropertyCount"
      ],
      "properties": {
        "entry": {
          "allOf": [
            { "$ref": "#/$defs/snapshot" },
            { "type": "object", "properties": { "path": { "const": "tailwind-profile.css" } } }
          ]
        },
        "animationSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "version", "path", "sha256"],
          "properties": {
            "package": { "const": "tw-animate-css" },
            "version": { "const": "1.4.0" },
            "path": { "const": "dist/tw-animate.css" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "compiler": {
          "allOf": [
            { "$ref": "#/$defs/snapshot" },
            {
              "type": "object",
              "properties": { "path": { "const": "scripts/lib/compile-tailwind-css.mjs" } }
            }
          ]
        },
        "scoper": {
          "allOf": [
            { "$ref": "#/$defs/snapshot" },
            { "type": "object", "properties": { "path": { "const": "scripts/lib/scope-tailwind-css.mjs" } } }
          ]
        },
        "networkBlocker": {
          "allOf": [
            { "$ref": "#/$defs/snapshot" },
            { "type": "object", "properties": { "path": { "const": "scripts/lib/block-network.mjs" } } }
          ]
        },
        "toolchainSha256": { "$ref": "#/$defs/sha256" },
        "scopeSeedSha256": { "$ref": "#/$defs/sha256" },
        "scopeValue": { "type": "string", "pattern": "^skui-[a-f0-9]{16}$" },
        "scopeSelector": {
          "type": "string",
          "pattern": "^\\[data-spfx-ui-scope=\"skui-[a-f0-9]{16}\"\\]$"
        },
        "artifact": {
          "allOf": [
            { "$ref": "#/$defs/snapshot" },
            { "type": "object", "properties": { "path": { "const": "generated/tailwind-profile.css" } } }
          ]
        },
        "candidateCount": { "type": "integer", "minimum": 1 },
        "structuralMarkers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^skui:(?:group|peer)(?:/[a-z0-9-]+)?$" }
        },
        "conditionalClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "keyframeCount": { "type": "integer", "minimum": 1 },
        "containerCount": { "type": "integer", "minimum": 0 },
        "fallbackPropertyCount": { "type": "integer", "minimum": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registrySourcePath", "upstreamSha256", "path", "sha256", "transformations"],
      "properties": {
        "registrySourcePath": { "type": "string" },
        "upstreamSha256": { "$ref": "#/$defs/sha256" },
        "path": { "type": "string", "pattern": "^normalized/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "transformations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "raw", "canonical", "normalized"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "raw": { "$ref": "#/$defs/snapshot" },
        "canonical": { "$ref": "#/$defs/snapshot" },
        "normalized": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/output" }
        }
      }
    }
  }
}
