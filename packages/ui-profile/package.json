    "./styles.css": "./generated/tailwind-profile.css",
    "./delivery": {
      "types": "./delivery.d.ts",
      "import": "./delivery.mjs",
      "require": "./delivery.cjs"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.mjs"
    },
    "./spfx-webpack": "./spfx-ui-webpack.cjs",
    "./spfx-gulp": "./spfx-ui-gulp.cjs"
