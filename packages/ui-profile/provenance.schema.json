{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spfx-kit.dev/schemas/ui-profile-provenance-v1.json",
  "title": "SPFx Kit UI source-profile provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatorVersion",
    "profileId",
    "registry",
    "runtime",
    "reactTypeContract",
    "utilities",
    "cssToolchain",
    "tailwindCompilerClosureSha256",
    "dependencyResolutionPins",
    "typescriptMatrix",
    "normalization",
    "registryIds",
    "registrySnapshots",
    "excludedDependencies",
    "directProductionDependencies"
  ],
  "$defs": {
    "snapshotDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawSha256", "canonicalSha256"],
      "properties": {
        "rawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "canonicalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "properties": {
    "$schema": { "const": "./provenance.schema.json" },
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "const": "1.1.0" },
    "profileId": { "const": "spfx-react17-base-nova-v1" },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "endpointTemplate",
        "toolSourceRepository",
        "toolSourceRevision",
        "cli",
        "mutableHostedResponses",
        "hostedResponsesRevisionBound"
      ],
      "properties": {
        "preset": { "const": "base-nova" },
        "endpointTemplate": { "const": "https://ui.shadcn.com/r/styles/base-nova/{id}.json" },
        "toolSourceRepository": { "const": "https://github.com/shadcn-ui/ui" },
        "toolSourceRevision": { "const": "cb2bcd88d93b2f9bddb030e9136f1f8773e7eac4" },
        "mutableHostedResponses": { "const": true },
        "hostedResponsesRevisionBound": { "const": false },
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "integrity"],
          "properties": {
            "name": { "const": "shadcn" },
            "version": { "const": "4.16.1" },
            "integrity": {
              "const": "sha512-XLFzfNNIUPlUlyheFEzj0H4Vnhi9nI0nl3Nfgg8HYXW1FkUVhVT1X+mgmOUW8aWL5SeG0A+yJIV5fm3Hr9MVkQ=="
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["react", "reactDom", "baseUi", "lucideReact"],
      "properties": {
        "react": { "const": "17.0.1" },
        "reactDom": { "const": "17.0.1" },
        "baseUi": { "const": "1.6.0" },
        "lucideReact": { "const": "1.25.0" }
      }
    },
    "reactTypeContract": {
      "const": {
        "@types/react": "17.0.45",
        "@types/react-dom": "17.0.17"
      }
    },
    "utilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class-variance-authority", "clsx", "tailwind-merge"],
      "properties": {
        "class-variance-authority": { "const": "0.7.1" },
        "clsx": { "const": "2.1.1" },
        "tailwind-merge": { "const": "3.6.0" }
      }
    },
    "cssToolchain": {
      "const": {
        "tailwindcss": {
          "version": "4.3.3",
          "integrity": "sha512-gOhV3P7ufE62QDGg1zVaTgCR+EtPv92k2nIhVcVKcLmxT1sUBsQGhnZj175j+MqRt4zLF7ic+sCYjfhxMxj7YQ=="
        },
        "@tailwindcss/cli": {
          "version": "4.3.3",
          "integrity": "sha512-ZvS/n1ZHOBKcVlhkt8l5NNr1EDXk1NboYO5CYDOs6NUmvT9z6bzkwsosaJftY57T/3gWNzWMJzIXLodZC8ssdw=="
        },
        "postcss": {
          "version": "8.5.19",
          "integrity": "sha512-Mz8SaolMd8nB+G13WkORcxQKHZ/NE4xXevtkJHVuG+guo9/wYKlIMTKAqGdEmYOXR2ijPjTYNHssizdaVSUNdQ=="
        },
        "postcss-selector-parser": {
          "version": "7.1.4",
          "integrity": "sha512-HeP7D2wyhkR+XaK6v4W8oRF62Dsz4flyuczALJp61GckGm42u1saSSJ/0auvcBqxs3jMRFEcPK34At/0JBKdOg=="
        },
        "postcss-value-parser": {
          "version": "4.2.0",
          "integrity": "sha512-1NNCs6uurfkVbeXG4S8JFT9t19m45ICnif8zWLd5oPSZ50QnwMfK+H3jv408d4jw/7Bttv5axS5IiHoLaVNHeQ=="
        },
        "tw-animate-css": {
          "version": "1.4.0",
          "integrity": "sha512-7bziOlRqH0hJx80h/3mbicLW7o8qLsH5+RaLR2t+OHM3D0JlWGODQKQ4cxbK7WlvmUxpcj6Kgu6EKqjrGFe3QQ=="
        }
      }
    },
    "tailwindCompilerClosureSha256": {
      "const": "d6f6eb30ddf06feab95c95ea5262af3d31a95ae2b6ab3ba2c450c93edcad4726"
    },
    "dependencyResolutionPins": {
      "const": {
        "@floating-ui/core": "1.7.5",
        "@floating-ui/dom": "1.7.6",
        "@floating-ui/react-dom": "2.1.8",
        "@floating-ui/utils": "0.2.11"
      }
    },
    "typescriptMatrix": { "const": ["5.3.3", "5.8.3"] },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "configuration", "implementation", "implementationSha256"],
      "properties": {
        "contractVersion": { "const": "react17-classic-jsx-skui-v2" },
        "configuration": {
          "const": {
            "tailwindPrefix": "skui",
            "rtl": false,
            "menuColor": null,
            "fontHeadingMarker": "font-heading"
          }
        },
        "implementation": { "const": "scripts/lib/profile.mjs" },
        "implementationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "registryIds": {
      "const": [
        "button",
        "input",
        "field",
        "textarea",
        "checkbox",
        "switch",
        "select",
        "combobox",
        "toggle-group",
        "tabs",
        "accordion",
        "dropdown-menu",
        "dialog",
        "sheet",
        "popover",
        "tooltip",
        "alert",
        "badge",
        "spinner",
        "label",
        "separator",
        "input-group",
        "toggle",
        "utils"
      ]
    },
    "registrySnapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "button",
        "input",
        "field",
        "textarea",
        "checkbox",
        "switch",
        "select",
        "combobox",
        "toggle-group",
        "tabs",
        "accordion",
        "dropdown-menu",
        "dialog",
        "sheet",
        "popover",
        "tooltip",
        "alert",
        "badge",
        "spinner",
        "label",
        "separator",
        "input-group",
        "toggle",
        "utils"
      ],
      "properties": {
        "button": { "$ref": "#/$defs/snapshotDigests" },
        "input": { "$ref": "#/$defs/snapshotDigests" },
        "field": { "$ref": "#/$defs/snapshotDigests" },
        "textarea": { "$ref": "#/$defs/snapshotDigests" },
        "checkbox": { "$ref": "#/$defs/snapshotDigests" },
        "switch": { "$ref": "#/$defs/snapshotDigests" },
        "select": { "$ref": "#/$defs/snapshotDigests" },
        "combobox": { "$ref": "#/$defs/snapshotDigests" },
        "toggle-group": { "$ref": "#/$defs/snapshotDigests" },
        "tabs": { "$ref": "#/$defs/snapshotDigests" },
        "accordion": { "$ref": "#/$defs/snapshotDigests" },
        "dropdown-menu": { "$ref": "#/$defs/snapshotDigests" },
        "dialog": { "$ref": "#/$defs/snapshotDigests" },
        "sheet": { "$ref": "#/$defs/snapshotDigests" },
        "popover": { "$ref": "#/$defs/snapshotDigests" },
        "tooltip": { "$ref": "#/$defs/snapshotDigests" },
        "alert": { "$ref": "#/$defs/snapshotDigests" },
        "badge": { "$ref": "#/$defs/snapshotDigests" },
        "spinner": { "$ref": "#/$defs/snapshotDigests" },
        "label": { "$ref": "#/$defs/snapshotDigests" },
        "separator": { "$ref": "#/$defs/snapshotDigests" },
        "input-group": { "$ref": "#/$defs/snapshotDigests" },
        "toggle": { "$ref": "#/$defs/snapshotDigests" },
        "utils": { "$ref": "#/$defs/snapshotDigests" }
      }
    },
    "excludedDependencies": {
      "const": ["cmdk@1.1.1", "sonner@2.0.7", "@radix-ui/*", "react-aria-components", "vaul"]
    },
    "directProductionDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@base-ui/react", "class-variance-authority", "clsx", "lucide-react", "react", "react-dom", "tailwind-merge"],
      "properties": {
        "@base-ui/react": { "const": "1.6.0" },
        "class-variance-authority": { "const": "0.7.1" },
        "clsx": { "const": "2.1.1" },
        "lucide-react": { "const": "1.25.0" },
        "react": { "const": "17.0.1" },
        "react-dom": { "const": "17.0.1" },
        "tailwind-merge": { "const": "3.6.0" }
      }
    }
  }
}
