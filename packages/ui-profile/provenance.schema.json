{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spfx-kit.dev/schemas/ui-profile-provenance-v1.json",
  "title": "SPFx Kit UI source-profile provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatorVersion",
    "profileId",
    "registry",
    "runtime",
    "reactTypeContract",
    "utilities",
    "dependencyResolutionPins",
    "typescriptMatrix",
    "compilerContract",
    "normalization",
    "registryIds",
    "excludedDependencies",
    "directProductionDependencies"
  ],
  "properties": {
    "$schema": { "const": "./provenance.schema.json" },
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "const": "1.0.0" },
    "profileId": { "const": "spfx-react17-base-nova-v1" },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "endpointTemplate",
        "toolSourceRepository",
        "toolSourceRevision",
        "cli",
        "mutableHostedResponses",
        "hostedResponsesRevisionBound"
      ],
      "properties": {
        "preset": { "const": "base-nova" },
        "endpointTemplate": { "const": "https://ui.shadcn.com/r/styles/base-nova/{id}.json" },
        "toolSourceRepository": { "const": "https://github.com/shadcn-ui/ui" },
        "toolSourceRevision": { "const": "cb2bcd88d93b2f9bddb030e9136f1f8773e7eac4" },
        "mutableHostedResponses": { "const": true },
        "hostedResponsesRevisionBound": { "const": false },
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "integrity"],
          "properties": {
            "name": { "const": "shadcn" },
            "version": { "const": "4.16.1" },
            "integrity": {
              "const": "sha512-XLFzfNNIUPlUlyheFEzj0H4Vnhi9nI0nl3Nfgg8HYXW1FkUVhVT1X+mgmOUW8aWL5SeG0A+yJIV5fm3Hr9MVkQ=="
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["react", "reactDom", "baseUi", "lucideReact"],
      "properties": {
        "react": { "const": "17.0.1" },
        "reactDom": { "const": "17.0.1" },
        "baseUi": { "const": "1.6.0" },
        "lucideReact": { "const": "1.25.0" }
      }
    },
    "reactTypeContract": {
      "const": {
        "@types/react": "17.0.45",
        "@types/react-dom": "17.0.17"
      }
    },
    "utilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class-variance-authority", "clsx", "tailwind-merge"],
      "properties": {
        "class-variance-authority": { "const": "0.7.1" },
        "clsx": { "const": "2.1.1" },
        "tailwind-merge": { "const": "3.6.0" }
      }
    },
    "dependencyResolutionPins": {
      "const": {
        "@floating-ui/core": "1.7.5",
        "@floating-ui/dom": "1.7.6",
        "@floating-ui/react-dom": "2.1.8",
        "@floating-ui/utils": "0.2.11"
      }
    },
    "typescriptMatrix": { "const": ["5.3.3", "5.8.3"] },
    "compilerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^[^/].*" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "implementation"],
      "properties": {
        "contractVersion": { "const": "react17-classic-jsx-v1" },
        "implementation": { "const": "scripts/lib/profile.mjs" }
      }
    },
    "registryIds": {
      "const": [
        "button",
        "input",
        "field",
        "textarea",
        "checkbox",
        "switch",
        "select",
        "combobox",
        "toggle-group",
        "tabs",
        "accordion",
        "dropdown-menu",
        "dialog",
        "sheet",
        "popover",
        "tooltip",
        "alert",
        "badge",
        "spinner",
        "label",
        "separator",
        "input-group",
        "toggle",
        "utils"
      ]
    },
    "excludedDependencies": {
      "const": ["cmdk@1.1.1", "sonner@2.0.7", "@radix-ui/*", "react-aria-components", "vaul"]
    },
    "directProductionDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@base-ui/react", "class-variance-authority", "clsx", "lucide-react", "react", "react-dom", "tailwind-merge"],
      "properties": {
        "@base-ui/react": { "const": "1.6.0" },
        "class-variance-authority": { "const": "0.7.1" },
        "clsx": { "const": "2.1.1" },
        "lucide-react": { "const": "1.25.0" },
        "react": { "const": "17.0.1" },
        "react-dom": { "const": "17.0.1" },
        "tailwind-merge": { "const": "3.6.0" }
      }
    }
  }
}
