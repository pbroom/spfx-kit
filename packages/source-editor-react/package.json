{
  "name": "@spfx-kit/source-editor-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React 17-compatible inline and floating source editor with lazy Monaco loading.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spfx-webpack": "./spfx-monaco-webpack.cjs"
  },
  "scripts": {
    "prebuild": "npm --workspace @spfx-kit/ui-profile run profile:prepare:base-ui",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@spfx-kit/source-editor-core": "file:../source-editor-core"
  },
  "peerDependencies": {
    "@base-ui/react": "1.6.0",
    "class-variance-authority": ">=0.7.1 <1.0.0",
    "clsx": ">=2.1.1 <3.0.0",
    "lucide-react": ">=1.25.0 <2.0.0",
    "monaco-editor": ">=0.50.0 <1.0.0",
    "react": ">=17.0.0 <18.0.0",
    "react-dom": ">=17.0.0 <18.0.0",
    "tailwind-merge": ">=3.6.0 <4.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "monaco-editor": "0.53.0",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tailwind-merge": "3.6.0",
    "typescript": "5.3.3"
  }
}
